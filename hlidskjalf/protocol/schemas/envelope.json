{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"description":"Versioned JSON message envelope for Project Hliðskjálf (protocol v1).","properties":{"id":{"description":"ULID-style sortable unique id.","pattern":"^[0-9A-HJKMNP-TV-Z]{26}$","type":"string"},"meta":{"additionalProperties":true,"description":"Optional routing metadata (trace_id, correlation_id, is_reply, ...).","properties":{"correlation_id":{"type":"string"},"is_reply":{"type":"boolean"},"reply_to":{"type":"string"},"trace_id":{"type":"string"}},"type":"object"},"payload":{"description":"Message body.","type":"object"},"source":{"description":"Name of the sending subsystem.","type":"string"},"ts":{"description":"Unix epoch seconds when the envelope was built.","minimum":0,"type":"number"},"type":{"description":"Dotted message type, e.g. 'host.state'.","pattern":"^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$","type":"string"},"v":{"description":"Protocol version. Unknown versions are rejected.","enum":[1],"type":"integer"}},"required":["v","id","ts","type","source","payload"],"title":"HlidskjalfEnvelope","type":"object"}